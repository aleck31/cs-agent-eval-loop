# Copy this file to .env and edit. `.env` is gitignored and never committed.
#
#     cp .env.example .env
#     make validate
#
# You should not need to `export` anything by hand. Precedence, highest first:
#
#     1. explicit CLI flag       --region us-west-2
#     2. exported env var        AWS_REGION=us-west-2 make validate
#     3. this file
#     4. built-in default        (shown as the value below)
#
# Every line below is already set to its built-in default, so an unedited copy
# behaves identically to no .env at all.


# ---------------------------------------------------------------------------
# AWS access
# ---------------------------------------------------------------------------

# Named profile from ~/.aws/credentials or ~/.aws/config.
# Leave blank to use the normal credential chain (instance role, SSO, env keys).
#
# Whichever identity you use needs BOTH `bedrock:InvokeModel` AND
# `bedrock-agentcore:Evaluate`. Evaluate is a separate IAM action -- working
# Bedrock access tells you nothing about whether evaluation will work, and an
# EC2 instance role that can call Bedrock may still be denied Evaluate.
# Run `make validate` first; it prints the account it resolved to.
AWS_PROFILE=

# Region for both Bedrock and AgentCore Evaluations.
AWS_REGION=us-east-1


# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Agent under test, `make propose`, and the red-line judge created by `make evaluators`.
# Built-in judges run service-side on a model you do not choose.
CS_EVAL_MODEL_ID=global.anthropic.claude-sonnet-5-5

# Red-line judges: 1 to 3 comma-separated Bedrock model IDs, each its own evaluator,
# combined by majority vote (a tie is a breach). Mix families so no model grades only
# itself. Applied by `make evaluators`; built-in judges run on a model the service chooses.
CS_EVAL_JUDGE_MODEL_IDS=global.openai.gpt-6.1-terra,global.anthropic.claude-sonnet-5-5,global.xai.grok-4.7


# ---------------------------------------------------------------------------
# Cost control
# ---------------------------------------------------------------------------

# Hard ceiling in USD for a single command. The run projects its cost first and
# refuses to start if it would exceed this, then re-checks after every
# conversation and stops mid-run if it crosses. A full 12-case before/after run
# costs about $2.30 in judge calls plus roughly $0.60 in agent generation.
CS_EVAL_MAX_USD=5.00

# Which evaluator set to run. Cost scales directly with this:
#   minimal - 2 evaluators (GoalSuccessRate, InstructionFollowing)  ~$0.55
#   core    - 7 evaluators, the default scorecard                   ~$2.30
#   full    - core + Helpfulness as a soft CSAT proxy               ~$2.80
CS_EVAL_EVALUATORS=core

# Use only the first N conversations. 0 means all of them. The cheapest way to
# shrink a run without losing the shape of the report.
CS_EVAL_LIMIT=0


# ---------------------------------------------------------------------------
# Inputs
# ---------------------------------------------------------------------------

# Golden set path: the fixed cases and ground truth every variant is scored on. No code change needed to swap it.
# See README "Building your own golden set" for the format.
CS_EVAL_DATA=data/golden_set.yaml

# Which prompt files under prompts/ to compare, without the .md extension.
# These name the "before" and "after" sides of the comparison.
CS_EVAL_BASELINE=baseline
CS_EVAL_IMPROVED=improved


# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------

# live     - generate fresh answers and score them        (costs money)
# replay   - render the committed fixtures                ($0, no credentials)
# deployed - DOCUMENTED ONLY, UNVERIFIED; see README
CS_EVAL_MODE=live
